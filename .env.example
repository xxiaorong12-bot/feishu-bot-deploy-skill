# Copy to .env in the bot project you are deploying. Do not commit real values.

# Local service
APP_HOST=127.0.0.1
APP_PORT=18080
FEISHU_CALLBACK_PATH=/lark/events
HEALTH_PATH=/health

# Public HTTPS tunnel or hosted URL, without trailing slash.
# Examples:
# PUBLIC_BASE_URL=https://example.trycloudflare.com
# PUBLIC_BASE_URL=https://your-bot.example.com
PUBLIC_BASE_URL=

# Feishu / Lark app identity.
# Keep secrets local. Never paste full values in chat, docs, screenshots, or logs.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Optional outgoing custom bot webhook for one-way smoke messages.
FEISHU_WEBHOOK_URL=
